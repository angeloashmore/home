FROM node:lts-bookworm

RUN corepack enable

RUN apt-get update && apt-get install -y --no-install-recommends \
    vim ripgrep jq less tree \
    chromium fonts-liberation fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# pbcopy via OSC 52
RUN echo '#!/bin/bash' > /usr/local/bin/pbcopy && \
    echo 'printf "\e]52;c;%s\a" "$(base64 | tr -d "\n")" > /dev/tty' >> /usr/local/bin/pbcopy && \
    chmod +x /usr/local/bin/pbcopy

# `open` and `xclip` (clipboard paste) forward to the host Mac via the claudec bridge
COPY open xclip /usr/local/bin/
RUN chmod +x /usr/local/bin/open /usr/local/bin/xclip && \
    ln -sf /usr/local/bin/open /usr/local/bin/xdg-open

RUN useradd -m -s /bin/bash agent \
  && install -d -o agent -g agent /home/agent/.local/bin /home/agent/.local/share/claude /home/agent/.local/state

# force HTTPS for GitHub (container has GH_TOKEN, no SSH key)
RUN printf '[url "https://github.com/"]\n\tinsteadOf = git@github.com:\n\tinsteadOf = ssh://git@github.com/\n' \
    > /etc/gitconfig

ENV EDITOR=vim
ENV TERM=xterm-256color
# .local/bin last: the persisted claude install must not shadow system binaries
ENV PATH="${PATH}:/home/agent/.local/bin"
# route URL-opening through the host `open` shim
ENV BROWSER=/usr/local/bin/open
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=1
