FROM node:lts-bookworm

# Corepack (yarn + pnpm)
RUN corepack enable

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim ripgrep jq less tree \
    chromium fonts-liberation fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# OSC 52 clipboard shims (for tmux/terminal passthrough)
RUN echo '#!/bin/bash' > /usr/local/bin/pbcopy && \
    echo 'printf "\e]52;c;%s\a" "$(base64 | tr -d "\n")" > /dev/tty' >> /usr/local/bin/pbcopy && \
    chmod +x /usr/local/bin/pbcopy && \
    ln -s /usr/local/bin/pbcopy /usr/local/bin/xclip

# Create agent user
RUN useradd -m -s /bin/bash agent

# Force HTTPS for GitHub at the system level (container has GH_TOKEN but no SSH key).
# Kept in /etc/gitconfig so the user's ~/.config/git can be mounted live without being clobbered.
RUN printf '[url "https://github.com/"]\n\tinsteadOf = git@github.com:\n\tinsteadOf = ssh://git@github.com/\n' \
    > /etc/gitconfig

ENV EDITOR=vim
ENV TERM=xterm-256color
ENV PATH="/home/agent/.local/bin:${PATH}"

# Point Puppeteer / chrome-devtools-mcp at the system Chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=1

# Claude Code
USER agent
RUN curl -fsSL https://claude.ai/install.sh | bash
