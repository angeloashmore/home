#!/usr/bin/env bash
# claudec `open` shim: forwards to the host Mac's `open` via the session spool.
# Fire-and-forget; policy (http(s) URLs, files under working dirs) is enforced host-side.
set -uo pipefail

fail() { echo "open: $*" >&2; exit 1; }

[[ $# -ge 1 ]] || fail "usage: open <file|URL>"
spool="${CLAUDEC_OPEN_SPOOL:-}"
[[ -n "$spool" && -d "$spool" ]] || fail "host bridge not available"

target="$1"

if [[ "$target" == http://* || "$target" == https://* ]]; then
  IFS=, read -ra maps <<< "${CLAUDEC_PORTS:-}"
  for m in ${maps[@]+"${maps[@]}"}; do
    target="$(sed -E "s#(localhost|127\.0\.0\.1):${m%%=>*}\b#localhost:${m##*:}#g" <<< "$target")"
  done
elif [[ "$target" != *://* && -e "$target" ]]; then
  target="$(realpath "$target")"
fi

tmp="$(mktemp "$spool/.tmp.XXXXXX")" || fail "could not write to the spool"
printf '%s' "$target" > "$tmp"
mv -f "$tmp" "$spool/req.${tmp##*/.tmp.}"
