#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="claudec"
SCRIPT_DIR="$(cd "$(dirname "$0")/claudec.d" && pwd)"

# Rebuild on explicit --rebuild, or if the image doesn't exist yet
if [[ "${1:-}" == "--rebuild" ]]; then
  shift
  BUILD=1
elif ! container image inspect "$IMAGE_NAME" &>/dev/null; then
  BUILD=1
fi

if [[ "${BUILD:-0}" == "1" ]]; then
  echo "Building $IMAGE_NAME image..."
  cp "$HOME/.config/git/config" "$SCRIPT_DIR/gitconfig"
  cp "$HOME/.config/git/ignore" "$SCRIPT_DIR/gitignore"
  container build --no-cache -t "$IMAGE_NAME" --memory 4G "$SCRIPT_DIR"
fi

# Read env vars from host Claude settings
ENV_FLAGS=()
SETTINGS_FILE="$HOME/.config/claude/settings.json"
if [[ -f "$SETTINGS_FILE" ]]; then
  while IFS='=' read -r key value; do
    ENV_FLAGS+=(--env "$key=$value")
  done < <(jq -r '.env // {} | to_entries[] | "\(.key)=\(.value)"' "$SETTINGS_FILE")
fi

# Forward GitHub token from host keychain
GH_TOKEN="$(gh auth token 2>/dev/null || true)"
if [[ -n "$GH_TOKEN" ]]; then
  ENV_FLAGS+=(--env "GH_TOKEN=$GH_TOKEN")
fi

# Run the container
CONTAINER_HOME="/home/agent"

mkdir -p "$SCRIPT_DIR/nvim"

# PR template repo referenced by global CLAUDE.md
PRISMIC_GITHUB_MOUNT=()
if [[ -d "$HOME/projects/prismic/.github" ]]; then
  PRISMIC_GITHUB_MOUNT=(-v "$HOME/projects/prismic/.github:$HOME/projects/prismic/.github:ro")
fi

PRISMIC_CONFIG_MOUNT=()
if [[ -d "$HOME/.config/prismic" ]]; then
  PRISMIC_CONFIG_MOUNT=(-v "$HOME/.config/prismic:$CONTAINER_HOME/.config/prismic")
fi

exec container run -it --rm --init --progress none --memory 2G \
  --env HOME="$CONTAINER_HOME" \
  --env CLAUDE_CONFIG_DIR="$CONTAINER_HOME/.config/claude" \
  "${ENV_FLAGS[@]}" \
  -v "$(pwd):$(pwd)" \
  -w "$(pwd)" \
  -v "$HOME/.config/claude:$CONTAINER_HOME/.config/claude" \
  -v "$SCRIPT_DIR/nvim:$CONTAINER_HOME/.local/share/nvim" \
  "${PRISMIC_GITHUB_MOUNT[@]}" \
  "${PRISMIC_CONFIG_MOUNT[@]}" \
  -u agent \
  "$IMAGE_NAME" \
  claude --dangerously-skip-permissions \
  "$@"
