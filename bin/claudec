#!/usr/bin/env bash
# usage: claudec [-a <dir>]... [claude args...]
#   -a, --add-dir <dir>  mount an extra directory and register it with claude
#
# rebuild image:  container image rm claudec   (rebuilds on next run)
# claude updates itself; the install persists in ~/.local/share/claudec
set -euo pipefail

IMAGE=claudec
SCRIPT_DIR="$(cd "$(dirname "$0")/claudec.d" && pwd)"
AGENT_HOME=/home/agent
CWD="$(pwd)"
BASE="$(basename "$CWD" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/^-*//')"
NAME="$BASE"
n=2
while container list --all --quiet | grep -qxF "$NAME"; do NAME="$BASE-$n"; n=$((n + 1)); done

ADD_DIRS=()
PASSTHROUGH=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --add-dir|-a)
      [[ $# -ge 2 ]] || { echo "claudec: $1 requires a directory" >&2; exit 1; }
      ADD_DIRS+=("$2"); shift 2 ;;
    --add-dir=*) ADD_DIRS+=("${1#*=}"); shift ;;
    *) PASSTHROUGH+=("$1"); shift ;;
  esac
done

container image inspect "$IMAGE" &>/dev/null \
  || container build -t "$IMAGE" --memory 4G "$SCRIPT_DIR"

CLAUDE_DIR="$HOME/.local/share/claudec"
if [[ ! -x "$CLAUDE_DIR/bin/claude" && ! -L "$CLAUDE_DIR/bin/claude" ]]; then
  mkdir -p "$CLAUDE_DIR/bin" "$CLAUDE_DIR/share/claude"
  container run --rm -u agent \
    -v "$CLAUDE_DIR/bin:$AGENT_HOME/.local/bin" \
    -v "$CLAUDE_DIR/share/claude:$AGENT_HOME/.local/share/claude" \
    "$IMAGE" bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
fi

ENV_FLAGS=()
GH_TOKEN="$(gh auth token 2>/dev/null || true)"
[[ -n "$GH_TOKEN" ]] && ENV_FLAGS+=(--env "GH_TOKEN=$GH_TOKEN")

MOUNTS=(
  "$CWD:$CWD"
  "$CLAUDE_DIR/bin:$AGENT_HOME/.local/bin"
  "$CLAUDE_DIR/share/claude:$AGENT_HOME/.local/share/claude"
  "$HOME/.config/claude:$AGENT_HOME/.config/claude"
  "$HOME/.config/git:$AGENT_HOME/.config/git:ro"
  "$HOME/.config/gh:$AGENT_HOME/.config/gh:ro"
  "$HOME/.config/prismic:$AGENT_HOME/.config/prismic"
  "$HOME/.config/.wrangler:$AGENT_HOME/.config/.wrangler"
  "$HOME/.config/claude/skills:$AGENT_HOME/.claude/skills"
  "$HOME/.agents:$AGENT_HOME/.agents:ro"
  # both homes, so "~/projects/prismic/.github" resolves on host and in container
  "$HOME/projects/prismic/.github:$HOME/projects/prismic/.github:ro"
  "$HOME/projects/prismic/.github:$AGENT_HOME/projects/prismic/.github:ro"
  # screenshots, both homes, so dragged file paths resolve in the container
  "$HOME/Screenshots:$HOME/Screenshots:ro"
  "$HOME/Screenshots:$AGENT_HOME/Screenshots:ro"
)

CLAUDE_FLAGS=()
OPEN_ROOTS=("$CWD")
for dir in ${ADD_DIRS[@]+"${ADD_DIRS[@]}"}; do
  [[ -d "$dir" ]] || { echo "claudec: no such directory: $dir" >&2; exit 1; }
  abs="$(cd "$dir" && pwd)"
  [[ "$abs" == "$CWD" || "$abs" == "$CWD"/* ]] && continue
  MOUNTS+=("$abs:$abs")
  CLAUDE_FLAGS+=(--add-dir "$abs")
  OPEN_ROOTS+=("$abs")
done

MOUNT_FLAGS=()
for m in "${MOUNTS[@]}"; do
  if [[ -e "${m%%:*}" ]]; then MOUNT_FLAGS+=(-v "$m"); fi
done

# host bridge: in-container shims drop request files here; this watcher acts
# on the host. req.* -> `open` (http(s) URLs and files under the session's
# working dirs only); clip.* -> clipboard read (mime type in the file, bytes out).
SPOOL="$(mktemp -d "${TMPDIR:-/tmp}/claudec-open.XXXXXX")"

open_watch() {
  local r p f t roots=()
  for r in "${OPEN_ROOTS[@]}"; do roots+=("$(cd "$r" && pwd -P)"); done
  while [[ -d "$SPOOL" ]] && kill -0 $$ 2>/dev/null; do
    for f in "$SPOOL"/req.* "$SPOOL"/clip.*; do
      [[ -e "$f" ]] || continue
      case "$f" in *.out) continue ;; esac
      t="$(cat "$f")"; rm -f "$f"
      case "$f" in
        "$SPOOL"/clip.*)
          case "$t" in
            TARGETS) # claude probes for an image before pasting
              { osascript -e 'clipboard info' 2>/dev/null | grep -qE 'PNGf|TIFF' \
                  && printf 'image/png\n' > "$f.tmp"; } || : > "$f.tmp" ;;
            image/png)
              osascript -e "set f to open for access POSIX file \"$f.tmp\" with write permission" \
                        -e 'write (the clipboard as «class PNGf») to f' \
                        -e 'close access f' >/dev/null 2>&1 || : > "$f.tmp" ;;
            text/*) pbpaste > "$f.tmp" 2>/dev/null || : > "$f.tmp" ;;
            *) : > "$f.tmp" ;;
          esac
          mv -f "$f.tmp" "$f.out" ;;
        *)
          case "$t" in
            http://*|https://*) open "$t" || true ;;
            *://*) ;;
            *)
              p="$(cd "$(dirname "$t")" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "$(basename "$t")")" || continue
              for r in "${roots[@]}"; do
                [[ "$p" == "$r" || "$p" == "$r"/* ]] && { open "$p" || true; break; }
              done ;;
          esac ;;
      esac
    done
    sleep 0.1
  done
}

open_watch &
WATCH_PID=$!
trap 'kill "$WATCH_PID" 2>/dev/null; rm -rf "$SPOOL"' EXIT INT TERM

PORT_FLAGS=()
MAPS=()
h=30000
for c in 3000 5173; do
  while lsof -nP -iTCP:$h -sTCP:LISTEN &>/dev/null; do h=$((h + 1)); done
  PORT_FLAGS+=(-p "$h:$c"); MAPS+=("$c=>localhost:$h"); h=$((h + 1))
done
CLAUDEC_PORTS="$(IFS=,; echo "${MAPS[*]}")"

CONTEXT="<container-environment>
You are running inside an isolated Linux container ('claudec') on the user's Mac — not on the host.
Published ports (container => host): $CLAUDEC_PORTS
- Bind dev servers to 0.0.0.0 on a published container port; if a tool defaults to another port, override it.
- Give the user the matching http://localhost:<host port> URL, never the container port. Live mapping: echo \$CLAUDEC_PORTS
- 'open <http(s)-URL | file>' runs on the host Mac; published localhost ports are translated. Files must be under the session's working dirs.
- Ctrl+V pastes the user's host clipboard, including screenshot images (xclip bridges to the host).
- ~/Screenshots is mounted read-only; the user's newest screenshot lands there a few seconds after capture. A dragged /var/folders/... thumbnail path never exists (macOS deletes it) — Read the matching file in ~/Screenshots instead.
</container-environment>"

# DISPLAY: no X server exists; claude only attempts the xclip clipboard bridge when it is set
container run -it --rm --init --progress none --memory 8G --cpus 4 \
  --name "$NAME" \
  --env HOME="$AGENT_HOME" \
  --env CLAUDE_CONFIG_DIR="$AGENT_HOME/.config/claude" \
  --env CLAUDEC=1 \
  --env DISPLAY=:0 \
  --env CLAUDEC_PORTS="$CLAUDEC_PORTS" \
  --env CLAUDEC_OPEN_SPOOL="$SPOOL" \
  ${ENV_FLAGS[@]+"${ENV_FLAGS[@]}"} \
  ${PORT_FLAGS[@]+"${PORT_FLAGS[@]}"} \
  -v "$SPOOL:$SPOOL" \
  "${MOUNT_FLAGS[@]}" \
  -w "$CWD" \
  -u agent \
  "$IMAGE" \
  claude --permission-mode auto \
  --append-system-prompt "$CONTEXT" \
  ${CLAUDE_FLAGS[@]+"${CLAUDE_FLAGS[@]}"} \
  ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
